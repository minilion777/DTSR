{
  "experiment": "Experiment 4: module-aware adaptive long-horizon attacks",
  "seed": 42,
  "attacker": "module_aware_cem_mpc",
  "structure": {
    "4A": {
      "target": "Deadline Denial",
      "knowledge_ladder": ["K0", "K1", "K2", "K3", "K4"]
    },
    "4B": {
      "knowledge": "K4",
      "targets": ["Deadline Denial", "Economic Shift"]
    },
    "excluded": {
      "Grid-Stress/Synchronization": "Future work; DTSR currently targets single-vehicle local recovery and action safety."
    }
  },
  "attack_constraints": {
    "epsilon_linf": 0.075,
    "temporal_eta_linf": 0.045,
    "total_l1_budget": 1.2,
    "attack_ratio": 1.0
  },
  "cem_mpc": {
    "horizon": 8,
    "samples": 64,
    "iterations": 3,
    "elite_frac": 0.125,
    "discount": 0.97,
    "restarts": 3
  },
  "aggregation": {
    "knowledge_summary_mode": "single_knowledge_level",
    "cumulative_best_of_across_knowledge": false,
    "restart_selection": "Only select among random restarts within the same condition; never select best-of across K0-K4."
  },
  "commands": {
    "preflight": "python scripts/21_evaluate_exp4_adaptive_long_horizon_seed42.py --preflight",
    "smoke": "python scripts/21_evaluate_exp4_adaptive_long_horizon_seed42.py --split val --scenes 1 --restarts 1 --horizon 2 --samples 4 --iterations 1 --conditions 4A_deadline_K0,4A_deadline_K4,4B_economic_K4 --output-dir runs/exp4_module_aware_long_horizon_seed42_smoke --overwrite",
    "validation_pilot": "python scripts/21_evaluate_exp4_adaptive_long_horizon_seed42.py --split val --scenes 10 --restarts 2 --horizon 8 --samples 64 --iterations 3 --overwrite",
    "test_main": "python scripts/21_evaluate_exp4_adaptive_long_horizon_seed42.py --split test --scenes 120 --restarts 3 --horizon 8 --samples 64 --iterations 3 --overwrite",
    "convergence_h12_s128": "python scripts/21_evaluate_exp4_adaptive_long_horizon_seed42.py --split test --scenes 20 --restarts 3 --horizon 12 --samples 128 --iterations 3 --output-dir runs/exp4_module_aware_long_horizon_seed42_convergence_h12_s128 --overwrite"
  },
  "outputs": {
    "raw_jsonl": "runs/exp4_module_aware_long_horizon_seed42/intermediate/exp4_rollouts.jsonl",
    "all_restarts": "runs/exp4_module_aware_long_horizon_seed42/tables/exp4_all_restarts.csv",
    "selected_restarts": "runs/exp4_module_aware_long_horizon_seed42/tables/exp4_selected_restarts.csv",
    "main_table": "runs/exp4_module_aware_long_horizon_seed42/tables/table_exp4_main.csv",
    "mechanism_table": "runs/exp4_module_aware_long_horizon_seed42/tables/table_exp4_mechanisms.csv"
  }
}
